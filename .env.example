# Anthropic API key, used for the reasoning steps that pick the career page
# and the job opening link out of a generic, unknown website structure.
ANTHROPIC_API_KEY=

# RapidAPI credentials for LinkedIn data extraction.
# Default target: "linkedin-data-api" on RapidAPI (host below). If you subscribe
# to a different LinkedIn scraper, update RAPIDAPI_HOST and the parsing in
# src/linkedin_source.py to match its response shape.
RAPIDAPI_KEY=
RAPIDAPI_HOST=linkedin-data-api.p.rapidapi.com
